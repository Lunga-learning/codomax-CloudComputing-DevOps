# Flask application security
SECRET_KEY=replace-with-a-secure-random-secret

# Database authentication mode:
# password = local Docker PostgreSQL
# iam = AWS Aurora PostgreSQL IAM authentication
DATABASE_AUTH_MODE=password

# PostgreSQL database configuration
POSTGRES_DB=devops_tracker
POSTGRES_USER=tracker_admin
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Database connection
DB_HOST=localhost
DB_PORT=5432

# AWS Aurora configuration
# Used when DATABASE_AUTH_MODE=iam
AURORA_HOST=your-aurora-cluster-endpoint
AWS_REGION=eu-north-1
